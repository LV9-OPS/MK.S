# Base de données (SQLite par défaut ; voir README pour PostgreSQL)
DATABASE_URL="file:./dev.db"

# Répertoire de stockage PRIVÉ des fichiers (ressources, captures). Jamais sous /public.
STORAGE_DIR="./storage"

# Premier compte administrateur (utilisé par `npm run db:seed`)
ADMIN_EMAIL="admin@mks.local"
ADMIN_PASSWORD="change-me-please-123"
ADMIN_NAME="Admin MK.S"

# Fuseau horaire de l'équipe pour les bornes de semaine
TEAM_TIMEZONE="Europe/Paris"

# Intégration FACEIT Data API (optionnelle) — clé serveur obtenue sur https://developers.faceit.com
FACEIT_API_KEY=""
# Identifiant de jeu FACEIT à synchroniser (récupéré via GET /games)
FACEIT_GAME_ID=""

# Hôtes supplémentaires autorisés pour les liens « Participer » (séparés par des virgules)
EXTRA_TOURNAMENT_HOSTS=""
